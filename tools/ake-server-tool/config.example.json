{
  "work_dir": "/var/lib/ake-tablecfg",
  "sdk": "/opt/ake-tablecfg/runtime/beyond-sdk.jar",
  "java": "/opt/ake-tablecfg/runtime/jdk/bin/java",
  "java_options": ["-Xms64m", "-Xmx512m", "-XX:ActiveProcessorCount=1", "--enable-native-access=ALL-UNNAMED"],
  "extraction_idle_timeout": 180,
  "credentials_file": "/etc/ake-tablecfg/credentials.json",
  "bucket": "akedatabase",
  "interval": 5,
  "request_timeout": 30,
  "upload_enabled": false,
  "upload_concurrency": 32,
  "download_concurrency": 32,
  "minimum_free_bytes": 5368709120,
  "retain_jobs": 2,
  "status_host": "127.0.0.1",
  "status_port": 18443,
  "status_token_file": "/etc/ake-tablecfg/status-token",
  "tls_cert": "",
  "tls_key": ""
}
